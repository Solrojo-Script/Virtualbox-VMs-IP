#!/usr/bin/env python3
"""List IPs belonging to connected VirtualBox VM adapters, excluding Docker bridges.

The network model is independent of GTK. The Shell extension uses --adapter-json;
--json remains available for older copies already loaded into GNOME Shell.
"""
import argparse
import json
import sys

from vbox_network import collect_snapshot, legacy_rows, rows_from_payload


def panel_snapshot(payload):
    """Accept current rows, or refresh a legacy two-column panel snapshot.

    Old Shell code can remain loaded until logout. Its VM/IP pairs lack the MAC
    and adapter information needed to filter Docker, so never trust or relabel
    those pairs: obtain a fresh, MAC-matched snapshot instead.
    """
    if isinstance(payload, list) and payload and isinstance(payload[0], list):
        if not all(isinstance(item, list) and len(item) == 2
                   and all(isinstance(value, str) for value in item) for item in payload):
            raise ValueError('Invalid legacy panel snapshot.')
        snapshot = collect_snapshot()
        return list(snapshot.rows), '\n'.join(snapshot.warnings)
    return rows_from_payload(payload), ''


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument('--gui', action='store_true', help='open the Virtualbox window')
    mode.add_argument('--adapter-json', action='store_true', help='print VM/adapter/IP objects')
    mode.add_argument('--json', action='store_true', help='print legacy VM/IP pairs')
    mode.add_argument('--panel-list', action='store_true', help=argparse.SUPPRESS)
    args = parser.parse_args()

    if args.panel_list:
        try:
            rows, notice = panel_snapshot(json.load(sys.stdin))
        except (ValueError, TypeError) as error:
            print(f'Virtualbox IPs: {error}', file=sys.stderr)
            return 1
    else:
        snapshot = collect_snapshot()
        rows, notice = list(snapshot.rows), '\n'.join(snapshot.warnings)
        if notice:
            print(notice, file=sys.stderr)
        if args.adapter_json:
            print(json.dumps([row.to_dict() for row in rows]))
            return int(bool(notice) and not rows)
        if args.json:
            print(json.dumps(legacy_rows(rows)))
            return int(bool(notice) and not rows)
        if not args.gui:
            for row in rows:
                print(f'{row.vm}\t{row.adapter}\t{row.ip}')
            if not rows:
                print(notice or 'No connected VM adapters with a published IP address.')
            return int(bool(notice) and not rows)

    from vbox_window import show_window
    return show_window(rows, notice)


if __name__ == '__main__':
    raise SystemExit(main())
